# Run directories: store, keys, live provider configs, env files with real credentials.
# Host-local and personal. Nothing here reaches the repository or the public tree.
.advocate/
.advocate-public/

# Author-local notes, session handoffs, personal/host-specific material.
# Public tree stays public. The tracked README explains the convention.
.private/*
!.private/README.md

# Pinned on-device evaluator GGUF. Fetch with npm run fetch:evaluator-model.
# The manifest stays committed so the pin is inspectable without the weights.
data/models/*.gguf
data/models/*.gguf.partial

# Host-local deploy paths and operator email. Templates stay in deploy/apache/.
deploy/local.env
