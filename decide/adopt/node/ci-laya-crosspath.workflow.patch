diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index f6354cb..77c438b 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -41,3 +41,31 @@ jobs:
 
       - name: build the interface
         run: npm run build:ui
+
+  # Laya cross-path identity (Python gate path vs Node shipped path), item by item on the fixed
+  # held-out items. Needs the pinned 1.7 GB fp32 bundle and a Python with laya 0.3.21, so it runs
+  # on a self-hosted runner that has them (repository variables AIRP_LAYA_BUNDLE_DIR and
+  # AIRP_LAYA_PYTHON). AIRP_LAYA_CROSSPATH_REQUIRED makes a missing bundle a failure, not a skip.
+  # Enabled by setting the repository variable AIRP_LAYA_CROSSPATH to 'on', or by hand.
+  laya-crosspath:
+    if: ${{ vars.AIRP_LAYA_CROSSPATH == 'on' || github.event_name == 'workflow_dispatch' }}
+    runs-on: [self-hosted, laya-bundle]
+    timeout-minutes: 60
+    env:
+      AIRP_LAYA_CROSSPATH_REQUIRED: '1'
+      AIRP_LAYA_BUNDLE_DIR: ${{ vars.AIRP_LAYA_BUNDLE_DIR }}
+      AIRP_LAYA_PYTHON: ${{ vars.AIRP_LAYA_PYTHON }}
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-node@v4
+        with:
+          node-version: '22.x'
+          cache: npm
+
+      - run: npm ci
+
+      - run: npm run build
+
+      - name: laya cross-path identity
+        run: node --test tools/evaluator-training/laya-crosspath.test.mjs
