+    # --- Task 3 step 4 (Laya adoption 2026-10-06): smaller-encoder experiment. ---
+    # AIRP_INIT_ENCODER (e.g. answerdotai/ModernBERT-base) + AIRP_INIT_ENCODER_REVISION + AIRP_INIT_ENCODER_SHA256:
+    # encoder initialised from that pinned Hub snapshot, decision head freshly initialised (laya build_model
+    # default init, seeded). Tokenizer stays the Laya snapshot's (vocab/merges identical to ModernBERT-base's),
+    # so preprocessing / sequences are byte-identical to the deciding run. Everything else unchanged.
+    init_enc = os.environ.get("AIRP_INIT_ENCODER")
+    if init_enc:
+        import hashlib
+        from huggingface_hub import hf_hub_download
+        rev = os.environ["AIRP_INIT_ENCODER_REVISION"]; want = os.environ["AIRP_INIT_ENCODER_SHA256"]
+        wpath = hf_hub_download(init_enc, "model.safetensors", revision=rev)
+        h = hashlib.sha256()
+        with open(wpath, "rb") as fh:
+            for blk in iter(lambda: fh.read(1 << 22), b""):
+                h.update(blk)
+        if h.hexdigest() != want:
+            raise SystemExit(f"init encoder sha {h.hexdigest()} != {want}")
+        cfg["encoder"] = init_enc
+        cfg["init_encoder_revision"] = rev
+        cfg["init_encoder_sha256"] = want
+        cfg.pop("temperature_by_options", None)
+        cfg["training"] = {"note": "fresh head on " + init_enc}
+        torch.manual_seed(args.seed); random.seed(args.seed); np.random.seed(args.seed)
+        model = build_model(cfg, encoder_dir=None, pretrained=True, revision=rev)
+        print(f"INIT_ENCODER {init_enc}@{rev} sha {want} params={sum(p.numel() for p in model.parameters())}")
+    else:
+        model = build_model(cfg, encoder_dir=str(model_dir / "encoder"))
+        weights = load_file(str(model_dir / "model.safetensors"))
